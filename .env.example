# Plantilla de variables de entorno.
# Copia este archivo como .env y escribe cada valor justo después del signo igual.
# git ignora .env: las llaves viven solo ahí, nunca en este archivo ni en el chat.
# Basta con la llave del proveedor del modelo que elijas en MODELO.
# Los comentarios van en su propia línea, nunca después del signo igual.

# Id del modelo que usa el agente.
MODELO=

# Llave de Anthropic, para los modelos Claude.
ANTHROPIC_API_KEY=

# Llave de la API de Gemini (Google AI Studio), para los modelos Gemini.
GOOGLE_API_KEY=
